

:root {
    --ek-navy: #0A3D8F;
    --ek-navy-deep: #072C6B;
    --ek-blue: #0757B5;
    --ek-blue-soft: #E8F1FE;
    --ek-red: #D91E25;
    --ek-red-dark: #B3151B;
    --ek-bg: #F3F7FC;
    --ek-border: #DDE6F0;
    --ek-text: #14213D;
    --ek-muted: #5B6678;
    --ek-green: #14733F;
    --ek-green-soft: #E6F6EC;
    --ek-amber: #8A5A00;
    --ek-amber-soft: #FFF3D6;
}

/* =====================================================================
   e-KONSULTA DASHBOARD FOUNDATION
===================================================================== */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
}

/* ---------- DASHBOARD LAYOUT ---------- */

.dashboard-body {
    min-height: 100vh;
    margin: 0;
    background: #F3F7FC;
}

.dashboard-wrapper {
    display: flex;
    min-height: 100vh;
    width: 100%;
}

/* ---------- SIDEBAR ---------- */

.sidebar {
    position: sticky;
    top: 0;
    left: 0;

    width: 260px;
    min-width: 260px;
    height: 100vh;

    display: flex;
    flex-direction: column;

    color: #fff;
    overflow-y: auto;
    overflow-x: hidden;
}

.sidebar-brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
}

.sidebar-navigation {
    flex: 1;
    padding: 8px 14px 20px;

    display: flex;
    flex-direction: column;
}

.nav-section {
    flex-shrink: 0;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 12px;

    width: 100%;

    text-decoration: none;
    transition: background 0.15s ease;
}

.nav-link span {
    display: flex;
    align-items: center;
}

.sidebar-bottom {
    margin-top: auto;
    flex-shrink: 0;
}

.system-status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #35C878;
    flex-shrink: 0;
}

.logout-button {
    width: 100%;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    border: 0;
    background: #fff;
    color: #14213D;

    cursor: pointer;
    font-family: inherit;
}

/* ---------- MAIN CONTENT ---------- */

.main-content {
    flex: 1;
    min-width: 0;
    min-height: 100vh;

    display: flex;
    flex-direction: column;
}

/* ---------- TOP BAR ---------- */

.topbar {
    min-height: 82px;
    padding: 16px 28px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    background: #fff;
}

.topbar-title {
    flex: 1;
    min-width: 0;
}

.topbar-title h2 {
    margin: 0;
}

.topbar-title p {
    margin: 4px 0 0;
}

.topbar-user {
    display: flex;
    align-items: center;
    gap: 10px;
}

.user-avatar {
    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;
    font-weight: 800;
}

.user-info {
    display: flex;
    flex-direction: column;
}

.user-info strong {
    font-size: 14px;
}

.user-info span {
    font-size: 12px;
}

/* ---------- PAGE CONTENT ---------- */

.page-content {
    flex: 1;
    padding: 28px;
    width: 100%;
}

/* ---------- DASHBOARD COMPONENTS ---------- */

.welcome-banner {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    overflow: hidden;
    color: #fff;
}

.welcome-banner h1,
.welcome-banner p {
    margin-top: 0;
}

.stats-grid {
    margin-top: 22px;
}

.stat-card {
    background: #fff;
    padding: 18px;

    display: flex;
    align-items: center;
    gap: 14px;
}

.stat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
}

.stat-information {
    min-width: 0;
}

.dashboard-grid {
    display: grid;
    margin-top: 22px;
}

.dashboard-card {
    background: #fff;
    min-width: 0;
}

.card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}

.card-header h3,
.card-header p {
    margin-top: 0;
}

.quick-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.quick-action {
    display: flex;
    flex-direction: column;

    background: #fff;
    color: inherit;
    text-decoration: none;
}

.quick-action strong,
.quick-action small {
    display: block;
}

.empty-state {
    text-align: center;
}

.appointment-preview {
    min-width: 0;
}

.appointment-details {
    overflow-wrap: anywhere;
}

/* ---------- MOBILE CONTROLS ---------- */

.mobile-menu-button {
    display: none;

    border: 1px solid #DDE6F0;
    border-radius: 8px;

    padding: 8px 11px;

    background: #fff;
    color: #0A3D8F;

    cursor: pointer;
    font-size: 20px;
}

.sidebar-overlay {
    display: none;
}

/* ---------- RESPONSIVE DASHBOARD ---------- */

@media (max-width: 900px) {

    .sidebar {
        position: fixed;
        z-index: 100;

        top: 0;
        bottom: 0;
        left: 0;

        transform: translateX(-100%);
        transition: transform 0.2s ease;
    }

    .sidebar.sidebar-open {
        transform: translateX(0);
    }

    .sidebar-overlay {
        position: fixed;
        inset: 0;
        z-index: 90;

        background: rgba(0, 0, 0, 0.35);
    }

    .sidebar-overlay.overlay-visible {
        display: block;
    }

    .mobile-menu-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .topbar {
        padding: 14px 18px;
    }

    .topbar-user {
        display: none;
    }

    .page-content {
        padding: 20px;
    }
}

@media (max-width: 600px) {

    .page-content {
        padding: 16px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .quick-actions {
        grid-template-columns: 1fr;
    }
}

html {
    font-family: "Inter", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
}

body {
    background: var(--ek-bg);
    color: var(--ek-text);
    line-height: 1.5;
}

:focus-visible {
    outline: 3px solid #2F80ED;
    outline-offset: 2px;
    border-radius: 6px;
}


/* ---------- SIDEBAR ---------- */

.sidebar {
    background: linear-gradient(180deg, #0B4A9E 0%, #072C6B 100%);
    box-shadow: 4px 0 24px rgba(7, 44, 107, 0.18);
}

.sidebar-brand {
    height: 90px;
    padding: 0 20px;
    gap: 12px;
}

.brand-icon {
    width: 48px;
    height: 48px;
    padding: 0;
    border-radius: 50%;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.25);
}

.brand-icon svg,
.brand-icon img {
    width: 100%;
    height: 100%;
    display: block;
}

.sidebar-brand h1 {
    font-size: 19px;
    font-weight: 800;
    line-height: 1.1;
}

.sidebar-brand span {
    font-size: 12px;
    opacity: 0.85;
}

.nav-section {
    margin: 20px 12px 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    opacity: 0.7;
}

.nav-link {
    position: relative;
    padding: 11px 14px;
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 14px;
    font-weight: 500;
}

.nav-link:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    transform: none;
}

.nav-link.active {
    background: #1E6ACB;
    color: #fff;
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
}

.nav-link.active::before {
    content: "";
    position: absolute;
    left: -14px;
    top: 9px;
    bottom: 9px;
    width: 4px;
    border-radius: 0 4px 4px 0;
    background: var(--ek-red);
}

.nav-link span:first-child {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    flex-shrink: 0;
}

.nav-svg {
    width: 20px;
    height: 20px;
    display: block;
}

.sidebar-bottom {
    padding: 14px;
}

.system-status {
    font-size: 12px;
    opacity: 0.9;
}

.status-dot {
    box-shadow: 0 0 0 3px rgba(53, 200, 120, 0.25);
}

.logout-button {
    padding: 11px 14px;
    border-radius: 10px;
    font-weight: 500;
}

.logout-button:hover {
    background: rgba(217, 30, 37, 0.85);
}

.logout-button span:first-child {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
}


/* ---------- TOP BAR ---------- */

.topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--ek-border);
    box-shadow: 0 1px 8px rgba(10, 61, 143, 0.05);
}

.topbar-title h2 {
    font-size: 22px;
    font-weight: 800;
    color: var(--ek-navy);
}

.topbar-title p,
.user-info span {
    color: var(--ek-muted);
}

.user-avatar {
    background: var(--ek-navy);
    color: #fff;
}


/* ---------- WELCOME BANNER ---------- */

.welcome-banner {
    background:
        radial-gradient(circle at 12px 12px, rgba(255, 255, 255, 0.10) 1.5px, transparent 1.6px) 0 0 / 22px 22px,
        linear-gradient(135deg, #0A3D8F 0%, #0757B5 100%);
    border-radius: 18px;
    padding: 30px 34px 34px;
    box-shadow: 0 10px 28px rgba(10, 61, 143, 0.20);
}

.welcome-banner::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 6px;
    background: linear-gradient(90deg, var(--ek-red) 0%, var(--ek-red) 38%, rgba(217, 30, 37, 0) 100%);
}

.welcome-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.4px;
    opacity: 0.9;
}

.welcome-banner h1 {
    font-size: 27px;
    font-weight: 800;
}

.welcome-banner p {
    font-size: 14.5px;
    opacity: 0.95;
}

.welcome-icon {
    width: 92px;
    height: 92px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 46px;
}


/* ---------- STATISTICS ---------- */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

.stat-card {
    border: 1px solid var(--ek-border);
    border-radius: 16px;
    box-shadow: 0 2px 10px rgba(10, 61, 143, 0.05);
}

.stat-card:hover {
    transform: none;
    box-shadow: 0 6px 18px rgba(10, 61, 143, 0.10);
}

.stat-icon {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 14px;
    background: var(--ek-blue-soft);
}

.stats-grid .stat-card:nth-child(2) .stat-icon { background: #E3F6F1; }
.stats-grid .stat-card:nth-child(3) .stat-icon { background: var(--ek-amber-soft); }
.stats-grid .stat-card:nth-child(4) .stat-icon { background: #FDE9EA; }

.stat-label {
    color: var(--ek-muted);
    font-size: 13px;
    font-weight: 600;
}

.stat-value {
    font-size: 28px;
    font-weight: 800;
    color: var(--ek-navy);
    line-height: 1.1;
}

.stat-information small {
    color: var(--ek-muted);
    font-size: 12px;
}


/* ---------- CARDS ---------- */

.dashboard-grid {
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 22px;
}

.dashboard-card {
    border: 1px solid var(--ek-border);
    border-radius: 18px;
    padding: 24px;
    box-shadow: 0 2px 10px rgba(10, 61, 143, 0.05);
}

.card-header h3 {
    font-size: 17px;
    font-weight: 800;
    color: var(--ek-navy);
}

.card-header p {
    color: var(--ek-muted);
    font-size: 13px;
}

.card-header a {
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--ek-blue-soft);
    color: var(--ek-navy);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
}

.card-header a:hover {
    background: var(--ek-navy);
    color: #fff;
}


/* ---------- BUTTONS ---------- */

.primary-button {
    padding: 12px 20px;
    border-radius: 10px;
    background: var(--ek-blue);
    font-size: 13px;
    font-weight: 700;
    text-align: center;
}

.primary-button:hover {
    background: var(--ek-navy-deep);
    transform: none;
}


/* ---------- EMPTY STATE ---------- */

.empty-state {
    margin-top: 18px;
    padding: 36px 20px;
    border: 1.5px dashed #C3D3E6;
    border-radius: 14px;
    background: #F9FBFF;
}

.empty-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--ek-blue-soft);
    font-size: 30px;
}

.empty-state h4 {
    font-size: 16px;
    font-weight: 700;
}

.empty-state p {
    color: var(--ek-muted);
    font-size: 13px;
}


/* ---------- QUICK ACTIONS ---------- */

.quick-actions {
    gap: 12px;
}

.quick-action {
    padding: 16px;
    border: 1px solid var(--ek-border);
    border-radius: 14px;
}

.quick-action:hover {
    border-color: var(--ek-blue);
    box-shadow: 0 6px 16px rgba(7, 87, 181, 0.12);
    transform: none;
}

.quick-action > span {
    width: 46px;
    height: 46px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--ek-blue-soft);
    font-size: 22px;
}

.quick-action strong {
    font-size: 14px;
    font-weight: 700;
}

.quick-action small {
    color: var(--ek-muted);
    font-size: 12px;
}


/* ---------- APPOINTMENT PREVIEW ---------- */

.appointments-list,
.medical-records-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.medical-records-list hr {
    display: none;
}

.appointment-preview {
    display: flex;
    gap: 16px;
    margin-top: 18px;
    padding: 16px;
    border: 1px solid var(--ek-border);
    border-radius: 14px;
    background: #F9FBFF;
}

.appointments-list .appointment-preview,
.medical-records-list .appointment-preview {
    margin-top: 0;
}

.appointments-list,
.medical-records-list {
    margin-top: 18px;
}

.appointment-date {
    width: 66px;
    min-width: 66px;
    height: 72px;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--ek-navy);
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.appointment-date strong {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    opacity: 0.9;
}

.appointment-date span {
    font-size: 26px;
    font-weight: 800;
    line-height: 1.1;
}

/* Staff dashboard shows time here (strong = 10:30, span = AM) */
.appointment-date--time strong {
    font-size: 20px;
    letter-spacing: 0;
    text-transform: none;
    opacity: 1;
}

.appointment-date--time span {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}

.appointment-details {
    flex: 1;
    min-width: 0;
}

.appointment-details h4 {
    margin: 0 0 8px;
    font-size: 15px;
    font-weight: 700;
    color: var(--ek-text);
}

.appointment-details p {
    margin: 4px 0;
    color: var(--ek-muted);
    font-size: 13px;
}

.appointment-details p strong {
    color: var(--ek-text);
}

.appointment-status {
    display: inline-block;
    margin-top: 10px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--ek-blue-soft);
    color: var(--ek-navy);
    font-size: 12px;
    font-weight: 700;
}

.appointment-status.status-approved,
.appointment-status.status-confirmed,
.appointment-status.status-completed {
    background: var(--ek-green-soft);
    color: var(--ek-green);
}

.appointment-status.status-pending,
.appointment-status.status-scheduled {
    background: var(--ek-amber-soft);
    color: var(--ek-amber);
}

.appointment-status.status-cancelled,
.appointment-status.status-rejected,
.appointment-status.status-no_show {
    background: #FDE9EA;
    color: var(--ek-red-dark);
}


/* ---------- HEALTH REMINDER ---------- */

.health-reminder {
    margin-top: 22px;
    border-left: 5px solid var(--ek-red);
    background: #FFFDFD;
}

.reminder-icon {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: #FDE9EA;
    font-size: 30px;
}

.health-reminder h3 {
    margin: 0 0 4px;
    font-size: 16px;
    font-weight: 800;
    color: var(--ek-navy);
}

.health-reminder p {
    margin: 0;
    color: var(--ek-muted);
    font-size: 13.5px;
}


/* =====================================================================
   AUTH PAGES (login + register)
===================================================================== */

.ek-auth {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    background: var(--ek-bg);
}

.ek-auth-brand {
    position: sticky;
    top: 0;
    height: 100vh;
    align-self: start;
    overflow: hidden;
    padding: 56px 56px 0;
    background: linear-gradient(160deg, #F8FBFF 0%, #E4EEFB 100%);
}

.ek-brand-content {
    position: relative;
    z-index: 2;
    max-width: 460px;
}

.ek-seal {
    width: 92px;
    height: 92px;
    display: block;
}

.ek-wordmark {
    margin: 22px 0 10px;
    font-size: 46px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.5px;
    color: var(--ek-navy);
}

.ek-wordmark span {
    display: block;
}

.ek-wordmark .ek-wordmark-red {
    color: var(--ek-red);
}

.ek-brand-sub {
    margin: 0 0 22px;
    color: var(--ek-muted);
    font-size: 15px;
    line-height: 1.6;
}

.ek-tagline {
    margin: 0;
    color: var(--ek-navy);
    font-size: 17px;
    font-weight: 800;
    line-height: 1.5;
}

.ek-tagline span {
    display: block;
}

.ek-skyline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 280px;
    z-index: 1;
}

.ek-auth-panel {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 48px 32px;
}

.ek-auth-panel--center {
    align-items: center;
}

.ek-card {
    width: 100%;
    max-width: 440px;
    padding: 38px;
    border: 1px solid var(--ek-border);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 14px 44px rgba(10, 61, 143, 0.10);
}

.ek-card--wide {
    max-width: 720px;
}

.ek-card h2 {
    margin: 0 0 6px;
    font-size: 26px;
    font-weight: 800;
    color: var(--ek-navy);
}

.ek-card-intro {
    margin: 0 0 24px;
    color: var(--ek-muted);
    font-size: 14px;
}

.ek-alert {
    margin-bottom: 20px;
    padding: 12px 14px;
    border: 1px solid #F1B8BA;
    border-left: 4px solid var(--ek-red);
    border-radius: 10px;
    background: #FFF3F3;
    color: #8E1519;
    font-size: 13.5px;
}

.ek-alert p {
    margin: 2px 0;
}

.ek-form {
    display: grid;
    gap: 18px;
}

.ek-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.ek-field label,
.ek-label {
    display: block;
    margin-bottom: 6px;
    color: var(--ek-text);
    font-size: 13.5px;
    font-weight: 700;
}

.ek-field--full {
    grid-column: 1 / -1;
}

.ek-input {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid #C2D0E2;
    border-radius: 10px;
    background: #fff;
    color: var(--ek-text);
    font-family: inherit;
    font-size: 15px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

textarea.ek-input {
    min-height: 92px;
    resize: vertical;
}

.ek-input:hover {
    border-color: #98AECA;
}

.ek-input:focus {
    outline: none;
    border-color: var(--ek-blue);
    box-shadow: 0 0 0 4px rgba(7, 87, 181, 0.16);
}

.ek-password {
    position: relative;
}

.ek-password .ek-input {
    padding-right: 76px;
}

.ek-toggle {
    position: absolute;
    top: 50%;
    right: 8px;
    transform: translateY(-50%);
    padding: 7px 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--ek-blue);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
}

.ek-toggle:hover {
    background: var(--ek-blue-soft);
}

.ek-help {
    display: block;
    margin-top: 6px;
    color: var(--ek-muted);
    font-size: 12.5px;
}

.ek-check {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ek-text);
    font-size: 14px;
    cursor: pointer;
}

.ek-check input {
    width: 18px;
    height: 18px;
    accent-color: var(--ek-blue);
}

.ek-btn {
    width: 100%;
    min-height: 50px;
    border: 0;
    border-radius: 10px;
    background: var(--ek-navy);
    color: #fff;
    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease;
}

.ek-btn:hover {
    background: var(--ek-navy-deep);
}

.ek-foot {
    margin: 22px 0 0;
    text-align: center;
    color: var(--ek-muted);
    font-size: 14px;
}

.ek-link {
    color: var(--ek-red-dark);
    font-weight: 700;
}

.ek-link:hover {
    text-decoration: underline;
}

.ek-section-title {
    grid-column: 1 / -1;
    margin: 10px 0 0;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--ek-blue-soft);
    color: var(--ek-navy);
    font-size: 15px;
    font-weight: 800;
}

.ek-section-title:first-child {
    margin-top: 0;
}


/* ---------- RESPONSIVE ---------- */

@media (max-width: 1100px) {
    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 900px) {
    .ek-auth {
        grid-template-columns: 1fr;
    }

    .ek-auth-brand {
        position: static;
        height: auto;
        padding: 28px 24px 30px;
        border-bottom: 5px solid var(--ek-red);
    }

    .ek-brand-content {
        display: grid;
        grid-template-columns: auto 1fr;
        column-gap: 16px;
        align-items: center;
        max-width: none;
    }

    .ek-seal {
        width: 64px;
        height: 64px;
        grid-row: span 2;
    }

    .ek-wordmark {
        margin: 0;
        font-size: 28px;
    }

    .ek-wordmark span {
        display: inline;
    }

    .ek-brand-sub,
    .ek-tagline,
    .ek-skyline {
        display: none;
    }

    .ek-auth-panel {
        padding: 28px 16px 40px;
    }
}

@media (max-width: 700px) {
    .welcome-banner {
        padding: 22px 22px 26px;
    }

    .welcome-banner h1 {
        font-size: 21px;
    }

    .welcome-banner p {
        font-size: 13px;
    }

    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .stat-card {
        padding: 14px;
        gap: 10px;
    }

    .stat-icon {
        width: 42px;
        height: 42px;
    }

    .stat-value {
        font-size: 22px;
    }

    .dashboard-card {
        padding: 18px;
    }

    .quick-actions {
        grid-template-columns: 1fr;
    }

    .appointment-preview {
        flex-direction: column;
        gap: 14px;
    }

    .appointment-date {
        width: 100%;
        min-width: 0;
        height: auto;
        padding: 10px;
        flex-direction: row;
        gap: 8px;
    }

    .health-reminder {
        align-items: flex-start;
    }
}

@media (max-width: 560px) {
    .ek-card {
        padding: 26px 20px;
        border-radius: 16px;
    }

    .ek-grid {
        grid-template-columns: 1fr;
    }

    .ek-input {
        font-size: 16px;
    }
}

@media (prefers-reduced-motion: reduce) {
    * {
        transition: none !important;
        animation: none !important;
    }
}